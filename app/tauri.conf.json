{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vibe Downloader",
  "identifier": "com.itsblqz.vibedownloader",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Vibe Downloader",
        "width": 1000,
        "height": 660,
        "minWidth": 720,
        "minHeight": 460,
        "dragDropEnabled": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "ItsBlqz",
    "copyright": "Copyright (c) 2026 ItsBlqz and the Vibe Downloader contributors",
    "license": "MIT OR Apache-2.0",
    "homepage": "https://github.com/ItsBlqz/vibe-downloader",
    "category": "Utility",
    "shortDescription": "Fast, clean download manager",
    "longDescription": "Multi-connection download manager with pause/resume, queueing and adaptive connections."
  }
}
