{
  "manifest_version": 3,
  "name": "Gimme That File",
  "short_name": "GimmeThatFile",
  "version": "0.1.0",
  "description": "Send browser downloads to the Gimme That File download manager.",
  "homepage_url": "https://github.com/ItsBlqz/gimmethatfile",
  "permissions": ["downloads", "cookies", "storage", "contextMenus"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["common.js", "background.js"]
  },
  "action": {
    "default_title": "Gimme That File",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "gimmethatfile@itsblqz",
      "strict_min_version": "128.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
